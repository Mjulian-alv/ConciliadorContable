@page "/perfiles"
@attribute [Authorize(Policy="ArcaPerfiles")]
@inject IWebConfigurationStore Store
@inject AccessGuard Access
@inject Workspace Work
@inject ILogger<Profiles> Logger
@* Fecha: 05/10/2026 - TAREA: 00064 - Linea: 4 - Cambios de perfil versionados, listas completas y orden explícito de directivas. *@
<PageTitle>Perfiles · ArcaCliente</PageTitle>
<div class="page-heading"><div><p class="eyebrow">CONFIGURACIÓN</p><h1>Perfiles de conciliación</h1><p>Una forma de trabajo para cada origen y archivo del sistema.</p></div><button class="primary" disabled="@busy" @onclick="()=>Act(Create)">+ Nuevo perfil</button></div>
@if(error!=null){<div class="notice error" role="alert">@error <button @onclick="()=>Act(Reload)">Recargar perfiles</button></div>}
@if(saved){<p class="save-state" role="status">✓ Cambios guardados automáticamente</p>}
<fieldset disabled="@busy"><div class="profile-layout"><section class="panel profile-list"><h2>Perfiles disponibles</h2>@foreach(var p in profiles){<button class="profile-choice @(editing?.Profile.Id==p.Profile.Id?"selected":"")" @onclick="()=>Choose(p)"><strong>@p.Profile.Nombre</strong><small>@(p.Source==ReconciliationSource.Arca?"Contra ARCA":"Cuenta corriente de proveedor")</small></button>}</section>
@if(editing!=null){<section class="panel"><div class="section-heading"><span class="step-number">P</span><div><h2>Configuración del perfil</h2><p>Los cambios válidos se guardan al salir de cada campo.</p></div></div><label>Nombre del perfil<input @bind="editing.Profile.Nombre" @bind:after="Changed" maxlength="200" /></label>
<div class="mode-options"><label class="mode-option"><input type="radio" name="source" checked="@(editing.Source==ReconciliationSource.Arca)" @onchange="()=>SourceChanged(ReconciliationSource.Arca)" /><span><strong>Contra ARCA</strong><small>Comprobantes recibidos, con lista de CUIT opcional.</small></span></label><label class="mode-option"><input type="radio" name="source" checked="@(editing.Source==ReconciliationSource.Provider)" @onchange="()=>SourceChanged(ReconciliationSource.Provider)" /><span><strong>Cuenta corriente de proveedor</strong><small>Un proveedor por conciliación; formato guardado por CUIT.</small></span></label></div>
@if(editing.Source==ReconciliationSource.Arca){
<div class="subpanel"><label class="check"><input type="checkbox" @bind="editing.FilterCuits" @bind:after="Changed" /> Filtrar ambos archivos por lista de CUIT</label><p>La nueva lista reemplaza completamente a la anterior después de validarla.</p><label>Importar lista (una columna CUIT)<InputFile OnChange="ReadCuits" accept=".csv,.txt,.xlsx" /></label>
@if(candidate!=null){<div class="notice"><strong>@candidate.Count CUIT válidos y únicos</strong><p>@string.Join(" · ",candidate.Take(10))@(candidate.Count>10?" …":"")</p><button @onclick="()=>Act(ReplaceCuits)">Reemplazar lista guardada</button><button @onclick="()=>candidate=null">Cancelar</button></div>}
<details><summary>Lista actual · @editing.Cuits.Count CUIT</summary><div class="cuit-list">@foreach(var c in editing.Cuits){<span>@c</span>}</div></details></div>
}else{<div class="notice">El CUIT se solicita antes de ingresar a la conciliación. El archivo del proveedor no necesita incluirlo.</div>}
<details><summary>Formato del archivo del sistema</summary><FormatEditor Format="editing.SystemFormat" OnChanged="Changed" /></details>
<div class="section-heading"><div><h2>Directivas de conciliación</h2><p>Se aplican en orden sobre los comprobantes que quedaron sin coincidencia.</p></div></div>
@for(int index=0;index<editing.Profile.DirectivasConciliacion.Count;index++){var i=index;var d=editing.Profile.DirectivasConciliacion[i];<div class="directive"><div class="toolbar"><strong>@(i+1). @(i==0?"Directiva principal":d.Descripcion)</strong>@if(i>0){<div><button disabled="@(i==1)" @onclick="()=>Move(i,-1)">↑</button><button disabled="@(i==editing.Profile.DirectivasConciliacion.Count-1)" @onclick="()=>Move(i,1)">↓</button><button @onclick="()=>Remove(i)">Quitar</button></div>}</div>
@if(i==0){<p>CUIT + Tipo de comprobante + Punto de venta + Número</p>}else{<label>Descripción<input @bind="d.Descripcion" @bind:after="Changed" /></label><div class="field-options">@foreach(var field in Enum.GetValues<CampoConciliacion>()){var f=field;<label class="check"><input type="checkbox" checked="@d.Campos.Contains(f)" @onchange="e=>FieldChanged(d,f,(bool)e.Value!)" /> @FieldName(f)</label>}</div>}</div>}
<button @onclick="AddDirective">+ Agregar directiva</button><div class="form-footer"><a class="button primary" href="/">Ir a conciliar →</a></div></section>}
</div></fieldset>
@code{
    List<WebProfile> profiles=new();WebProfile? editing;List<string>? candidate;bool busy,saved;string? error;
    static T Copy<T>(T v)=>System.Text.Json.JsonSerializer.Deserialize<T>(System.Text.Json.JsonSerializer.Serialize(v))!;
    protected override async Task OnInitializedAsync()=>await Act(Reload);
    async Task Act(Func<Task> action){if(busy)return;busy=true;error=null;saved=false;Work.Invalidate();try{await Access.Require("ArcaPerfiles");await action();}catch(Exception e){Logger.LogWarning(e,"No se pudo guardar el perfil");error=e is ImportException or ConfigurationConflictException or UnauthorizedAccessException?e.Message:"No se pudo guardar. Revisá la conexión y recargá el perfil."; }finally{busy=false;}}
    async Task Reload(){profiles=await Store.Profiles();editing=profiles.Count>0?Copy(profiles[0]):null;candidate=null;}
    void Choose(WebProfile p){editing=Copy(p);candidate=null;error=null;saved=false;}
    async Task Create(){var p=await Store.Save(new WebProfile());profiles=await Store.Profiles();editing=Copy(p);saved=true;}
    Task Changed()=>Act(Save);
    async Task Save(){if(editing==null)return;editing=await Store.Save(editing);profiles=await Store.Profiles();saved=true;}
    async Task SourceChanged(ReconciliationSource source){editing!.Source=source;await Changed();}
    async Task ReadCuits(InputFileChangeEventArgs e)=>await Act(async()=>{candidate=null;using var ms=new MemoryStream();await e.File.OpenReadStream(TabularReader.MaxBytes).CopyToAsync(ms);candidate=CuitListImporter.Parse(new(e.File.Name,ms.ToArray()));});
    async Task ReplaceCuits(){if(candidate==null)return;editing!.Cuits=candidate;await Save();candidate=null;}
    Task AddDirective(){editing!.Profile.DirectivasConciliacion.Add(DirectivaConciliacion.CrearUltima());return Changed();}
    Task Remove(int i){editing!.Profile.DirectivasConciliacion.RemoveAt(i);return Changed();}
    Task Move(int i,int direction){var list=editing!.Profile.DirectivasConciliacion;(list[i],list[i+direction])=(list[i+direction],list[i]);return Changed();}
    Task FieldChanged(DirectivaConciliacion d,CampoConciliacion f,bool selected){if(selected)d.Campos.Add(f);else d.Campos.Remove(f);return Changed();}
    static string FieldName(CampoConciliacion f)=>f switch{CampoConciliacion.TipoComprobante=>"Tipo",CampoConciliacion.PuntoVenta=>"Punto de venta",CampoConciliacion.Numero=>"Número",_=>f.ToString()};
}
