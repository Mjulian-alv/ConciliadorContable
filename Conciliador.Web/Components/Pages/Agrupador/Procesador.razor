@page "/agrupador/procesador"
@attribute [Authorize(Policy="AgrProcesador")]
@* Fecha: 14/10/2026 - TAREA: 00097 - Linea: 2 - Procesador de movimientos de banco: importar el extracto, homologar los conceptos y exportar el resultado (equivale a ProcesadorForm). La lógica está en Procesador.razor.cs. *@
<PageTitle>Procesador · Agrupador</PageTitle>
<div class="page-heading"><div><p class="eyebrow">AGRUPADOR DE CONCEPTOS</p><h1>Procesador de movimientos</h1><p>Importá el extracto, homologá los conceptos y exportá el resultado.</p></div></div>
@if(aviso!=null){<div class="notice" role="status">@aviso</div>}
@if(error!=null){<div class="notice error" role="alert">@error</div>}
<div class="context-strip"><div><span class="eyebrow">PERFIL DE BANCO</span>
    <select style="width:260px" aria-label="Perfil de banco" @bind="perfilId" @bind:after="CambioPerfil" disabled="@importando"><option value="0">Elegí un perfil…</option>@foreach(var p in perfiles){<option value="@p.Id">@p.NombreBanco</option>}</select>
    @* Fecha: 24/10/2026 - TAREA: 00125 - Linea: 4 - Enlace relativo al <base href> para que la app funcione bajo una subruta (PathBase) detrás del Concentrador. *@
    <a class="button" href="agrupador/perfiles">+ Nuevo perfil</a>
    @* Fecha: 24/10/2026 - TAREA: 00125 - Linea: 4 - Enlace relativo al <base href> para que la app funcione bajo una subruta (PathBase) detrás del Concentrador. *@
    @if(Perfil!=null){<a class="button" href="@($"agrupador/perfiles/{Perfil.Id}")">Editar perfil</a>}else{<button disabled>Editar perfil</button>}
    @if(Perfil!=null){<span>Perfil @Perfil.Id · @(Perfil.TipoImporte==1?$"importe único en «{Perfil.ColumnaImporteUnico}»":$"Debe «{Perfil.ColumnaDebe}» / Haber «{Perfil.ColumnaHaber}»") · encabezado en la fila @Perfil.FilaEncabezado</span>}</div></div>
<div style="height:16px"></div>
<section class="panel">
    <div class="section-heading"><span class="step-number">1</span><div><h2>Cargar archivo del banco</h2><p>Se lee, se homologa y se guarda. Si alguna fecha es inválida, no se guarda nada.</p></div></div>
    <div class="form-row"><label>Archivo del banco<InputFile OnChange="Elegir" accept=".xls,.xlsx,.csv" disabled="@importando" /><small>@(subido==null?".xls, .xlsx o .csv · hasta 25 MB":$"{subido.Nombre} · {Math.Max(1,subido.Tamano/1024):N0} KB")</small></label>
        <button class="primary" @onclick="Importar" disabled="@(importando||subido==null||Perfil==null)">Importar archivo</button></div>
    @if(importando)
    {
        <div class="stepper" role="status"><span class="@Clase(0)">@Marca(0) Leyendo archivo</span><span class="@Clase(1)">@Marca(1) Homologando</span>
            <span class="@Clase(2)">@Marca(2) Guardando en la base@(paso==2&&total>0?$" · {guardados:N0} / {total:N0}":"")</span><span class="@Clase(3)">@Marca(3) Mostrando datos</span></div>
        <div class="bar"><i style="width:@(Porcentaje())%"></i></div>
        <p class="note">Una importación por vez. Mientras corre no se puede borrar ni cargar otro archivo. Si cerrás la página, la importación se cancela y no queda nada a medias.</p>
    }
</section>
@if(incidencias!=null)
{
    <div class="notice error" role="alert"><strong>No se importó el archivo.</strong> Hay @incidencias.Count.ToString("N0",ar) fecha(s) vacía(s) o inválida(s). <strong>No se guardó ningún movimiento ni la cabecera.</strong> Corregí esas filas en el Excel y volvé a importarlo.</div>
    <section class="panel"><div class="section-heading"><div><h2>Filas con problemas</h2><p>Los números de fila son los del Excel.@(incidencias.Count>200?" Se muestran las primeras 200.":"")</p></div></div>
        <div class="table-wrap tall" style="max-height:320px"><table><thead><tr><th>Archivo</th><th>Hoja</th><th class="numeric">Fila</th><th>Valor leído</th><th>Motivo</th></tr></thead>
            <tbody>@foreach(var i in incidencias.Take(200)){<tr><td>@i.Archivo</td><td>@i.Hoja</td><td class="numeric">@i.Fila.ToString("N0",ar)</td><td>@(string.IsNullOrWhiteSpace(i.ValorOriginal)?"(vacía)":i.ValorOriginal)</td><td>@i.Motivo</td></tr>}</tbody></table></div></section>
}
<section class="panel">
    <div class="section-heading"><span class="step-number">2</span><div><h2>Archivo en trabajo</h2></div></div>
    <div class="form-row"><label>Archivos leídos<select aria-label="Archivos leídos" @bind="archivoSel" disabled="@(importando||archivos.Count==0)">@if(archivos.Count==0){<option value="0">(este perfil no tiene archivos)</option>}@foreach(var a in archivos){<option value="@a.Id">@a.DisplayName</option>}</select></label>
        <button @onclick="CargarDatos" disabled="@(importando||archivoSel==0)">Cargar datos</button><button @onclick="PedirBorrarArchivo" disabled="@(importando||archivoSel==0||archivoSeleccionado?.Blindado==true)" title="@(archivoSeleccionado?.Blindado==true?"Un archivo blindado no se da de baja hasta desblindarlo":null)">Borrar archivo</button></div>
    @* Fecha: 26/10/2026 - TAREA: 00135 - Linea: 3 - Blindaje del archivo en trabajo (cierre de homologación): con el archivo blindado sólo se concilia. *@
    @if(ArchivoEnTrabajo!=null)
    {
        <div class="actions">@if(Blindado){<span class="badge ok">Archivo blindado@(ArchivoEnTrabajo.BlindadoFecha.HasValue?" · "+ArchivoEnTrabajo.BlindadoFecha.Value.ToString("dd/MM/yyyy"):"")@(string.IsNullOrEmpty(ArchivoEnTrabajo.BlindadoPor)?"":" · "+ArchivoEnTrabajo.BlindadoPor)</span>
                <button @onclick="()=>dialogo=Dialogo.Desblindar" disabled="@(importando||ocupado)">Desblindar…</button>}
            else{<span class="badge warn">Archivo sin blindar</span><button class="primary" @onclick="Blindar" disabled="@(importando||ocupado)">Blindar archivo</button>}
            </div>
    }
</section>
@if(Movs==null)
{
    <section class="panel"><div class="empty"><div class="empty-icon" aria-hidden="true">▦</div><h2>Todavía no hay un archivo en trabajo</h2>
        <p class="muted">Elegí un perfil de banco, importá un extracto o abrí uno de los archivos ya leídos.<br>Si el banco no tiene perfil, creá uno con «+ Nuevo perfil».</p></div></section>
}
else
{
    <section class="panel">
        <div class="stats"><div>Registros leídos<strong>@Movs.Count.ToString("N0",ar)</strong></div><div>Homologados<strong>@homologados.ToString("N0",ar)</strong></div><div>Pendientes<strong>@(Movs.Count-homologados)</strong></div>
            <div>Débitos<strong>@FormatoImporte.Absoluto(sumaDebitos)</strong></div><div>Créditos<strong>@FormatoImporte.Absoluto(sumaCreditos)</strong></div><div>Diferencia (C − D)<strong>@FormatoImporte.Diferencia(sumaCreditos-sumaDebitos)</strong></div></div>
        <div class="actions"><button class="primary" @onclick="AbrirHomologar" disabled="@(actual==null||ocupado||Blindado)">Homologar fila seleccionada…</button><button @onclick="()=>dialogo=Dialogo.Pendientes" disabled="@(ocupado||Blindado)">Pendientes agrupados…</button>
            @* Fecha: 26/10/2026 - TAREA: 00135 - Linea: 2 - Historial de cambios del movimiento seleccionado. *@
            <button @onclick="()=>dialogo=Dialogo.Historial" disabled="@(actual==null||ocupado)">Historial del movimiento…</button>
            <button @onclick="AbrirConsolidado" disabled="@ocupado">Exportar consolidado…</button><button @onclick="ExportarDetalle" disabled="@(ocupado||vista.Count==0)">Exportar detalle…</button>
            <span class="grow"></span><input class="search" placeholder="Filtrar movimientos…" aria-label="Filtrar movimientos" @bind="filtro" @bind:event="oninput" @bind:after="Recalcular" />
            <label class="check"><input type="checkbox" @bind="soloPendientes" @bind:after="Recalcular" /> Sólo pendientes</label>
            @* Fecha: 23/10/2026 - TAREA: 00125 - Linea: 4 - Marcar como conciliados lo seleccionado o, sin selección, todo lo visible (equivale a ProcesadorForm). *@
            @* Fecha: 26/10/2026 - TAREA: 00135 - Linea: 3 - Conciliar exige el archivo blindado; con el archivo blindado no se eliminan movimientos. *@
            <button @onclick="PedirMarcarConciliados" disabled="@(ocupado||!Blindado||IdsParaConciliar().Count==0)" title="@(Blindado?null:"Para conciliar, blindá primero el archivo")">Marcar conciliados (@IdsParaConciliar().Count)</button>
            <button @onclick="PedirEliminarSeleccion" disabled="@(ocupado||Blindado||SeleccionVisible().Count==0)">Eliminar seleccionados (@SeleccionVisible().Count)</button></div>
        @if(ArchivoEnTrabajo!=null){<div class="notice" role="status">@(Blindado?"Archivo blindado: se permite conciliar, consultar y exportar. La homologación y la edición están bloqueadas hasta desblindarlo.":"Para conciliar, blindá primero el archivo. Homologar y editar movimientos siguen habilitados.")</div>}
        @if(vista.Count==0){<div class="empty"><p class="muted">Ningún movimiento coincide con el filtro.</p></div>}
        else
        {
            <div class="table-wrap tall" style="max-height:620px"><table>
                <thead><tr><th style="width:36px"><input type="checkbox" aria-label="Marcar los movimientos visibles" checked="@(vista.Count>0&&vista.All(m=>seleccion.Contains(m.Id)))" @onchange="e=>MarcarVisibles((bool)e.Value!)" /></th>
                    <th><button class="th-sort" @onclick='()=>Ordenar("fecha")'>Fecha@(Flecha("fecha"))</button></th><th><button class="th-sort" @onclick='()=>Ordenar("concepto")'>Concepto original@(Flecha("concepto"))</button></th>
                    <th><button class="th-sort" @onclick='()=>Ordenar("descripcion")'>Descripción@(Flecha("descripcion"))</button></th><th><button class="th-sort" @onclick='()=>Ordenar("estandar")'>Concepto estándar@(Flecha("estandar"))</button></th>
                    <th class="numeric"><button class="th-sort" @onclick='()=>Ordenar("debitos")'>Débitos@(Flecha("debitos"))</button></th><th class="numeric"><button class="th-sort" @onclick='()=>Ordenar("creditos")'>Créditos@(Flecha("creditos"))</button></th>
                    <th>Concepto final</th><th>Cuenta final</th><th>Conciliado</th></tr></thead>
                <tbody><Virtualize Items="vista" Context="m" ItemSize="48">
                    <tr class="@ClaseFila(m)" @onclick="()=>actual=m" @ondblclick="AbrirHomologar">
                        <td><input type="checkbox" aria-label="Marcar movimiento" checked="@seleccion.Contains(m.Id)" @onchange="e=>Marcar(m.Id,(bool)e.Value!)" @onclick:stopPropagation="true" /></td>
                        <td>@m.Fecha.ToString("dd/MM/yyyy")</td><td>@m.ConceptoOriginal</td><td>@m.DescripcionOriginal</td>
                        <td>@if(EsPendiente(m)){<span class="badge warn">Pendiente de homologar</span>}else{@m.ConceptoEstandar}</td>
                        <td class="numeric @(FormatoImporte.EsCero(m.Debitos)?"cero":"")">@FormatoImporte.Absoluto(m.Debitos)</td><td class="numeric @(FormatoImporte.EsCero(m.Creditos)?"cero":"")">@FormatoImporte.Absoluto(m.Creditos)</td>
                        <td><input class="celda" aria-label="Concepto final" value="@m.ConceptoFinal" disabled="@(m.Conciliado||Blindado)" @onchange="e=>CambioConceptoFinal(m,e)" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true" /></td>
                        <td><input class="celda corta" aria-label="Cuenta final" value="@m.CuentaFinal" disabled="@(m.Conciliado||Blindado)" @onchange="e=>CambioCuentaFinal(m,e)" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true" /></td>
                        <td>@if(m.Conciliado){<span class="badge ok">Conciliado@(m.ConciliadoFecha.HasValue?" "+m.ConciliadoFecha.Value.ToString("dd/MM/yyyy"):"")</span>}</td></tr>
                </Virtualize></tbody>
            </table></div>
            <p class="note">@vista.Count.ToString("N0",ar) de @Movs.Count.ToString("N0",ar) filas. «Concepto final» y «Cuenta final» se editan en el lugar y se guardan al salir de la celda. Doble clic en una fila para homologarla. Un movimiento conciliado no se edita.</p>
        }
    </section>
}
@if(dialogo==Dialogo.Homologar&&Perfil!=null&&actual!=null){<HomologarDialog IdPerfil="Perfil.Id" Valor="@actual.ConceptoOriginal" Permiso="AgrProcesador" Subtitulo="@("Perfil "+Perfil.NombreBanco)" OnCerrar="TrasHomologar" />}
@if(dialogo==Dialogo.ConfirmarRehomologar&&actual!=null){<AvisoDialog Titulo="Movimiento ya homologado" Mensaje="@($"El movimiento ya se encuentra homologado como «{actual.ConceptoEstandar}». ¿Querés crear una nueva homologación para «{actual.ConceptoOriginal}»?")" Confirmar="Crear nueva homologación" OnCerrar="TrasConfirmarRehomologar" />}
@if(dialogo==Dialogo.Pendientes&&Perfil!=null){<PendientesAgrupadosDialog Grupos="GruposPendientes()" OnHomologar="HomologarGrupo" OnCerrar="()=>dialogo=Dialogo.Ninguno" />}
@if(dialogo==Dialogo.PendientesHomologar&&Perfil!=null){<HomologarDialog IdPerfil="Perfil.Id" Valor="@valorGrupo" Permiso="AgrProcesador" Subtitulo="@("Perfil "+Perfil.NombreBanco+" · homologa todo el grupo")" OnCerrar="TrasHomologarGrupo" />}
@if(dialogo==Dialogo.Consolidado){<ConsolidadoDialog Lineas="lineasConsolidado" Titulo="@tituloConsolidado" Pendientes="pendientesConsolidado" OnExportar="ExportarConsolidado" OnCerrar="()=>dialogo=Dialogo.Ninguno" />}
@* Fecha: 26/10/2026 - TAREA: 00135 - Linea: 1 - La baja avisa lo modificado y deja el archivo inactivo, con sus movimientos archivados. *@
@if(dialogo==Dialogo.BorrarArchivo&&archivoSeleccionado!=null){<BajaArchivoDialog Archivo="@archivoSeleccionado.NombreArchivo" Mod="modBaja" Ocupado="ocupado" OnCerrar="TrasBorrarArchivo" />}
@if(dialogo==Dialogo.Desblindar&&ArchivoEnTrabajo!=null){<DesblindarDialog IdArchivo="ArchivoEnTrabajo.Id" Archivo="@ArchivoEnTrabajo.NombreArchivo" OnCerrar="TrasDesblindar" />}
@if(dialogo==Dialogo.Historial&&actual!=null){<HistorialMovimientoDialog IdMovimiento="actual.Id" Descripcion="@($"{actual.Fecha:dd/MM/yyyy} · {actual.ConceptoOriginal} · movimiento {actual.Id}")" OnCerrar="()=>{dialogo=Dialogo.Ninguno;return Task.CompletedTask;}" />}
@if(dialogo==Dialogo.EliminarSeleccion){<AvisoDialog Titulo="Eliminar movimientos" Mensaje="@($"¿Eliminar definitivamente {SeleccionVisible().Count.ToString("N0",ar)} movimiento(s) de «{archivoSeleccionado?.NombreArchivo}»?")" Nota="No se puede deshacer. Si alguno está tomado por una conciliación, no se elimina ninguno y se informa el motivo." Confirmar="Eliminar" Ocupado="ocupado" OnCerrar="TrasEliminarSeleccion" />}
@* Fecha: 23/10/2026 - TAREA: 00125 - Linea: 4 *@
@if(dialogo==Dialogo.MarcarConciliados){<AvisoDialog Titulo="Marcar como conciliados" Mensaje="@($"¿Marcar como conciliados {IdsParaConciliar().Count.ToString("N0",ar)} movimiento(s) {(HaySeleccionVisible()?"seleccionado(s)":"visible(s) con el filtro actual")} de «{archivoSeleccionado?.NombreArchivo}»?")" Nota="Los que ya están en una conciliación interna o externa (en proceso o finalizada) no se marcan. Los marcados dejan de ser candidatos de otras conciliaciones." Confirmar="Marcar" Ocupado="ocupado" OnCerrar="TrasMarcarConciliados" />}
@if(dialogo==Dialogo.Bloqueo){<AvisoDialog Titulo="@tituloBloqueo" Subtitulo="@archivoSeleccionado?.NombreArchivo" Mensaje="@mensajeBloqueo" Error="true" Nota="@notaBloqueo" OnCerrar="()=>dialogo=Dialogo.Ninguno" />}
