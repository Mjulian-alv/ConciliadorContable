@page "/"
@attribute [Authorize(Policy="ArcaOffline")]
@inject IWebConfigurationStore Store
@inject Workspace Work
@inject AccessGuard Access
@inject WebMode Mode
@inject IJSRuntime JS
@inject ILogger<Reconcile> Logger
@* Fecha: 05/10/2026 - TAREA: 00064 - Linea: 4 - Recorrido de configuración, validación y resultados del motor existente. *@
<PageTitle>Conciliación · ArcaCliente</PageTitle>
<div class="page-heading"><div><p class="eyebrow">COMPROBANTES FISCALES</p><h1>Conciliación</h1><p>Compará tus comprobantes con ARCA o con los pendientes de un proveedor.</p></div><a class="button" href="/perfiles">Administrar perfiles ↗</a></div>
@if(error!=null){<div class="notice error" role="alert">@error</div>}
<fieldset disabled="@busy">
@if(Work.Profile==null){
<section class="panel start-panel"><div class="section-heading"><span class="step-number">1</span><div><h2>Elegí cómo conciliar</h2><p>El perfil define la fuente, el formato del sistema y las directivas.</p></div></div>
<div class="form-row"><label>Perfil<select @bind="selectedId"><option value="">Seleccionar perfil</option>@foreach(var p in profiles){<option value="@p.Profile.Id">@p.Profile.Nombre</option>}</select></label>
@* Fecha: 06/10/2026 - TAREA: 00069 - Linea: 1 - El proveedor no trae CUIT; se exige aquí y se explica antes de intentar abrir el circuito. *@
@if(Selected?.Source==ReconciliationSource.Provider){<label>CUIT del proveedor<input @bind="cuit" @bind:event="oninput" placeholder="30-12345678-1" maxlength="20" aria-invalid="@(!ProviderCuitValid)" /><small>Obligatorio: 11 dígitos, con guiones o espacios opcionales. Se asignará a su archivo.</small>@if(!ProviderCuitValid){<small class="error-text">Ingresá un CUIT válido para continuar.</small>}</label>}</div>
@if(Selected!=null){<div class="notice">@(Selected.Source==ReconciliationSource.Provider?"Se concilian FC, NC y ND pendientes de pago. El archivo debe traer un único importe por comprobante.":Selected.FilterCuits?$"Se aplicará la lista de {Selected.Cuits.Count} CUIT a ambos archivos.":"Se concilian los comprobantes ARCA sin filtro de CUIT.")</div>}
@* Fecha: 06/10/2026 - TAREA: 00069 - Linea: 1 - Evita un intento imposible y conserva la validación del servidor como última comprobación. *@
<button class="primary" disabled="@(Selected==null||(Selected.Source==ReconciliationSource.Provider&&!ProviderCuitValid))" @onclick="()=>Act(Start)">Continuar →</button>
</section>
<div class="intro-grid"><div><span class="intro-number">01</span><h3>Prepará los archivos</h3><p>ARCA o cuenta corriente del proveedor, y el archivo de comprobantes de tu sistema.</p></div><div><span class="intro-number">02</span><h3>Revisá la vista previa</h3><p>Corregí el formato y confirmá equivalencias. Los datos originales permanecen intactos.</p></div><div><span class="intro-number">03</span><h3>Analizá las diferencias</h3><p>Consultá cada comprobante, el resumen por CUIT y descargá el resultado.</p></div></div>
}else{
<section class="context-strip"><div><span class="eyebrow">@Source.ToUpperInvariant()</span><strong>@Work.Profile.Profile.Nombre</strong><span>@(Work.Provider==null?(Work.Profile.FilterCuits?$"{Work.Profile.Cuits.Count} CUIT en la lista":"Todos los CUIT"):$"CUIT {Work.Provider.Cuit}")</span></div><button @onclick="()=>Act(Restart)">Cambiar perfil / CUIT</button></section>
<div class="steps"><span class="@(Work.External==null||Work.System==null?"current":"done")">1 · Archivos</span><span class="@(Work.Result==null?"current":"done")">2 · Revisión</span><span class="@(Work.Result!=null?"current":"")">3 · Resultado</span></div>
@if(Mode.Demo){<div class="demo-actions"><span>Probá el recorrido con archivos ficticios.</span><button @onclick="()=>Act(Example)">Cargar ejemplo de @Source</button></div>}
<div class="upload-grid">
@* Fecha: 06/10/2026 - TAREA: 00067 - Linea: 1 - ARCA se lee como histórico de carpeta; sólo proveedor mantiene selección de un archivo. *@
<section class="panel"><div class="section-heading"><span class="step-number">A</span><div><h2>@(Work.Provider==null?"Carpeta ARCA":"Archivo del proveedor")</h2><p>@(Work.Provider==null?"Se leen todos los CSV de esta carpeta, sin subcarpetas.":"Cuenta corriente con FC, NC y ND pendientes de pago.")</p></div></div>
@if(Work.Provider==null){<label>Carpeta ARCA<input @bind="Work.ArcaDirectory" @bind:after="Work.BeginExternalUpload" placeholder="Ruta de la carpeta compartida" /><small>La carpeta debe estar accesible desde el servidor web.</small></label><button @onclick="()=>Act(()=>Work.LoadArcaFolder(Work.ArcaDirectory))">Cargar / actualizar carpeta ARCA</button><p class="file-name">@Work.ExternalFiles.Count archivos CSV · @(Work.External?.Rows.Count??0) registros leídos</p>}
else{<label class="upload-box"><span>Seleccionar archivo</span><InputFile OnChange="UploadExternal" accept=".csv,.txt,.xlsx" /><small>XLSX, CSV o TXT · hasta 20 MB</small></label>}
<details><summary>Archivos leídos (@Work.ExternalFiles.Count)</summary><p class="file-name">@string.Join(", ",Work.ExternalFiles.Select(x=>x.Name))</p></details>
@if(Work.Provider!=null){<label class="check"><input type="checkbox" @bind="Work.PendingConfirmed" @bind:after="Work.Invalidate" /> El archivo contiene los comprobantes pendientes de pago.</label>}
</section>
<section class="panel"><div class="section-heading"><span class="step-number">B</span><div><h2>Archivo del sistema</h2><p>Se aplica el mismo CUIT o la misma lista que a la fuente.</p></div></div><label class="upload-box"><span>Seleccionar archivo</span><InputFile OnChange="UploadSystem" accept=".csv,.txt,.xlsx" /><small>Formato del perfil · hasta 20 MB</small></label><p class="file-name">@Work.SystemFile?.Name</p></section>
</div>
@if(Work.Provider!=null){<section class="panel"><details open="@(Work.External?.Ready==false)"><summary>Formato del proveedor <span class="muted">Un formato guardado por CUIT</span></summary><FormatEditor Format="Work.Provider.Format" Provider="true" OnChanged="()=>Act(Work.SaveProviderFormat)" /></details></section>}
<section class="panel"><details><summary>Formato del sistema <span class="muted">Se guarda en este perfil</span></summary><AuthorizeView Policy="ArcaPerfiles"><Authorized><FormatEditor Format="Work.Profile.SystemFormat" OnChanged="()=>Act(Work.SaveSystemFormat)" /></Authorized><NotAuthorized><p>Necesitás permiso de perfiles para modificar este formato.</p></NotAuthorized></AuthorizeView></details></section>
@if(Work.Provider!=null&&Work.External?.Rows.Count>0){
<section class="panel"><div class="section-heading"><span class="step-number">2</span><div><h2>Tipos de comprobante</h2><p>Confirmá la equivalencia con la tabla fiscal o excluí movimientos no fiscales.</p></div></div><div class="table-wrap"><table><thead><tr><th>Tipo en archivo</th><th>Filas</th><th>Equivalencia / exclusión</th><th>Confirmación</th></tr></thead><tbody>
@foreach(var group in Work.External.Rows.GroupBy(r=>r.RawType)){
var raw=group.Key;var existing=Work.Provider.MappingFor(raw);var choice=choices.GetValueOrDefault(raw,existing!=""?existing:FiscalCatalog.Suggest(raw));
<tr><td><strong>@(raw==""?"(vacío)":raw)</strong></td><td>@group.Count()</td><td><select aria-label="@("Equivalencia "+raw)" value="@choice" @onchange="e=>choices[raw]=e.Value?.ToString()??string.Empty"><option value="">Seleccionar equivalencia</option>@foreach(var t in FiscalCatalog.All){<option value="@t.Key">@t.Key · @t.Value</option>}<option value="EXCLUIR">Excluir de la conciliación</option></select></td><td><button disabled="@(choice==""||existing==choice)" @onclick="()=>Act(()=>Work.MapType(raw,choice))">@(existing!=""&&existing==choice?"Guardado":choice==""?"Sin asignar":"Confirmar")</button>@if(existing==""&&choice!=""){<small>Sugerencia pendiente de confirmar</small>}</td></tr>}
</tbody></table></div></section>}
@if(Work.Saved!=""){<p class="save-state" role="status">✓ @Work.Saved</p>}
@if(Work.External!=null){<section class="panel"><PreviewTable Preview="Work.External" Title="@("Vista previa · "+Source)" /></section>}
@if(Work.System!=null){<section class="panel"><PreviewTable Preview="Work.System" Title="Vista previa · Sistema" /></section>}
@* Fecha: 06/10/2026 - TAREA: 00067 - Linea: 2 - Informa el origen del período y permite ajustar el filtro antes de conciliar. *@
<section class="panel"><div class="form-row"><label>Desde<input type="date" @bind="Work.From" @bind:after="Work.Invalidate" /></label><label>Hasta<input type="date" @bind="Work.To" @bind:after="Work.Invalidate" /></label><div class="muted">El rango inicial se toma de las fechas del archivo del sistema. Podés ajustarlo para filtrar @Source y sistema. Se conservan las @Work.Profile.Profile.DirectivasConciliacion.Count directivas del perfil.</div><button class="primary" disabled="@(Work.External?.Ready!=true||Work.System?.Ready!=true||!Work.From.HasValue||!Work.To.HasValue||(Work.Provider!=null&&!Work.PendingConfirmed))" @onclick="()=>Act(Work.Reconcile)">Conciliar comprobantes →</button></div></section>
@if(Work.Result is {} result){
<section class="results" id="resultado"><div class="page-heading"><div><p class="eyebrow">RESULTADO</p><h2>Conciliación de comprobantes</h2><p>@result.Items.Count resultados · @result.ExternalOmitted de @Source y @result.SystemOmitted del sistema fuera del filtro</p></div><button @onclick="()=>Act(Export)">↓ Descargar Excel</button></div>
@* Fecha: 05/10/2026 - TAREA: 00066 - Linea: 1 - Tarjetas y filas usan la misma paleta RGB que WinForms y su Excel. *@
<div class="stat-grid">@foreach(var s in Enum.GetValues<EstadoConciliacion>()){<button class="stat result-state @(state==s.ToString()?"selected":"")" style="@StateStyle(s)" @onclick="()=>SetState(s.ToString())"><span>@ResultExporter.Label(s,Source)</span><strong>@result.Items.Count(x=>x.Estado==s)</strong><small>Ver comprobantes →</small></button>}</div>
<div class="panel"><div class="toolbar"><div class="tabs"><button class="@(tab==0?"active":"")" @onclick="()=>tab=0">Por comprobante</button><button class="@(tab==1?"active":"")" @onclick="()=>tab=1">Resumen por CUIT</button></div><button @onclick="()=>SetState(string.Empty)">Ver todos</button></div>
@if(tab==0){<label class="search-label">Buscar CUIT, proveedor o número<input @bind="search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Buscar en los resultados…" /></label><div class="table-wrap"><table><thead><tr><th>Estado</th><th>Fecha</th><th>CUIT / proveedor</th><th>Comprobante</th><th>@Source</th><th>Sistema</th><th>Diferencia</th><th>Directiva</th></tr></thead><tbody>
@foreach(var r in Filtered.Skip(resultPage*50).Take(50)){<tr class="result-state" style="@StateStyle(r.Estado)"><td><span class="badge state-label">@ResultExporter.Label(r.Estado,Source)</span></td><td>@r.Fecha</td><td>@r.CuitProveedor<small>@r.NombreProveedor</small></td><td>@r.TipoComprobante · @r.PuntoVenta-@r.Numero</td><td class="numeric">@r.TotalARCA</td><td class="numeric">@r.TotalSistema</td><td class="numeric">@r.Diferencia</td><td><details><summary>@(r.DirectivaAplicada>0?"Directiva "+r.DirectivaAplicada:"Sin coincidencia")</summary><p>@r.DescripcionDirectiva</p><p>@r.DetalleMatcheo</p><pre>@r.FalloDirectivas</pre></details></td></tr>}
</tbody></table></div><div class="pager"><button disabled="@(resultPage==0)" @onclick="()=>resultPage--">Anterior</button><span>@Filtered.Count() resultados · página @(resultPage+1)</span><button disabled="@((resultPage+1)*50>=Filtered.Count())" @onclick="()=>resultPage++">Siguiente</button></div>}
else{<p class="muted">Resumen con signo fiscal: FC y ND suman; NC resta. El emparejamiento compara magnitudes.</p><div class="table-wrap"><table><thead><tr><th>CUIT</th><th>@Source</th><th>Sistema</th><th>Diferencia</th></tr></thead><tbody>@foreach(var r in result.Summary){<tr><td>@r.Cuit</td><td class="numeric">@r.External.ToString("N2")</td><td class="numeric">@r.System.ToString("N2")</td><td class="numeric">@r.Difference.ToString("N2")</td></tr>}</tbody></table></div>}</div></section>}
}
</fieldset>
@code{
    // Fecha: 06/10/2026 - TAREA: 00069 - Linea: 1 - Conserva el perfil elegido al volver desde configuración.
    [SupplyParameterFromQuery(Name="perfil")] public Guid? PerfilInicial{get;set;}
    List<WebProfile> profiles=new();string selectedId="",cuit="",search="",state="";string? error;bool busy;int resultPage,tab;Dictionary<string,string> choices=new();
    WebProfile? Selected=>profiles.FirstOrDefault(x=>x.Profile.Id.ToString()==selectedId);
    // Fecha: 06/10/2026 - TAREA: 00069 - Linea: 1 - Usa el mismo normalizador que valida el CUIT al iniciar la conciliación.
    bool ProviderCuitValid {get{try{CuitListImporter.Normalize(cuit);return true;}catch(ImportException){return false;}}}
    string Source=>Work.Provider==null?"ARCA":"Proveedor";
    IEnumerable<ItemConciliacion> Filtered=>(Work.Result?.Items??new()).Where(x=>(state==""||x.Estado.ToString()==state)&&(search==""||((x.CuitProveedor??"")+" "+(x.NombreProveedor??"")+" "+x.Numero).Contains(search,StringComparison.OrdinalIgnoreCase)));
    protected override async Task OnInitializedAsync()=>await Act(async()=>{await Access.Require("ArcaOffline");profiles=await Store.Profiles();if(PerfilInicial.HasValue&&profiles.Any(p=>p.Profile.Id==PerfilInicial.Value))selectedId=PerfilInicial.Value.ToString();});
    async Task Act(Func<Task> action){if(busy)return;busy=true;error=null;try{await action();}catch(Exception e){Logger.LogWarning(e,"Operación de conciliación rechazada");error=e is ImportException or ConfigurationConflictException or UnauthorizedAccessException?e.Message:"No se pudo completar la operación. Revisá el archivo o recargá la configuración."; }finally{busy=false;}}
    async Task Start(){await Work.Select(Guid.Parse(selectedId),cuit);choices.Clear();state="";search="";resultPage=0;}
    async Task Restart(){Work.Clear();choices.Clear();profiles=await Store.Profiles();}
    static async Task<UploadedDocument> Read(IBrowserFile file){using var ms=new MemoryStream();await file.OpenReadStream(TabularReader.MaxBytes).CopyToAsync(ms);return new(Path.GetFileName(file.Name),ms.ToArray());}
    // Fecha: 06/10/2026 - TAREA: 00067 - Linea: 1 - La selección de archivo corresponde únicamente a cuenta corriente del proveedor.
    async Task UploadExternal(InputFileChangeEventArgs e){Work.BeginExternalUpload();await Act(async()=>{await Work.UploadExternal(new(){await Read(e.File)});choices.Clear();});}
    async Task UploadSystem(InputFileChangeEventArgs e){Work.BeginSystemUpload();await Act(async()=>await Work.UploadSystem(await Read(e.File)));}
    // Fecha: 06/10/2026 - TAREA: 00067 - Linea: 2 - El ejemplo utiliza el período derivado, igual que una importación normal.
    async Task Example(){if(!Mode.Demo)return;if(Work.Provider!=null){Work.Provider.Format=new FileFormat{NumberMode=NumberMode.Separated};await Work.SaveProviderFormat();}Work.Profile!.SystemFormat=new();await Work.SaveSystemFormat();await Work.UploadExternal(new(){Work.Provider==null?DemoFiles.Arca:DemoFiles.Provider});await Work.UploadSystem(DemoFiles.System);choices.Clear();}
    // Fecha: 06/10/2026 - TAREA: 00066 - Linea: 2 - La descarga usa el mismo nombre fechado del archivo que genera WinForms.
    async Task Export(){var bytes=await Work.Export();using var stream=new MemoryStream(bytes);using var reference=new DotNetStreamReference(stream);await JS.InvokeVoidAsync("downloadFile",$"Conciliacion_{DateTime.Now:yyyyMMdd_HHmm}.xlsx",reference);}
    void SetState(string s){state=s;resultPage=0;}
    // Fecha: 05/10/2026 - TAREA: 00066 - Linea: 1 - La conversión CSS consulta la paleta compartida para evitar colores divergentes entre hosts.
    static string StateStyle(EstadoConciliacion value){var c=EstadoConciliacionColores.Rgb[value];return $"--state-color:#{c.R:X2}{c.G:X2}{c.B:X2}";}
    void ResetPage()=>resultPage=0;
}
