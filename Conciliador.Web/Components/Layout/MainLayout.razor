@inherits LayoutComponentBase
@inject Conciliador.Web.Security.WebMode Mode
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@using Conciliador.Web.Services
@* Fecha: 14/10/2026 - TAREA: 00097 - Linea: 1 - Menú lateral por módulos, generado desde el catálogo de accesos y los permisos del usuario. *@
<div class="app-shell"><aside class="sidebar">
@* Fecha: 24/10/2026 - TAREA: 00125 - Linea: 4 - Enlace relativo al <base href> para que la app funcione bajo una subruta (PathBase) detrás del Concentrador. La ruta del catálogo (MenuPrincipal) sigue siendo absoluta: es la identidad de la sección. *@
<a href="./" class="brand"><span class="brand-mark">C</span><span>Conciliador<small>CONTABLE</small></span></a>
<div class="nav-caption">INICIO</div><nav><NavLink href="" Match="NavLinkMatch.All"><span>⌂</span> Inicio</NavLink></nav>
@foreach(var modulo in new[]{MenuPrincipal.ModArca,MenuPrincipal.ModAgrupador})
{
    var accesos=lateral.Where(a=>a.Modulo==modulo).ToList();
    if(accesos.Count==0)continue;
    <div class="nav-caption">@modulo</div><nav>
    @foreach(var a in accesos){<NavLink href="@a.Ruta.TrimStart('/')" Match="NavLinkMatch.All"><span>@a.Glifo</span> @a.Titulo</NavLink>}
    </nav>
}
@* Fecha: 28/10/2026 - TAREA: 00140 - Linea: 2 - Si la sesión la abrió AppHub no se ofrece «Cerrar sesión» (el pedido siguiente la volvería a abrir): se sale desde AppHub. *@
<div class="sidebar-foot"><span class="status-dot"></span> @nombre<small>Alvear Supermercados@(viaAppHub?" · sesión de AppHub":"")</small>@if(!viaAppHub){<a href="account/logout" data-enhance-nav="false">Cerrar sesión ↗</a>}</div></aside>
<div class="main-shell"><header class="topbar"><span>Conciliador Contable @if(seccion!=null){<span class="muted"> / @seccion</span>}</span><span class="pill">@(Mode.Demo?"DEMOSTRACIÓN LOCAL":"ENTORNO CONFIGURADO")</span></header>
@if(Mode.Demo){<div class="demo-bar">Datos de ejemplo · La configuración de demostración se conserva hasta reiniciar la aplicación.</div>}
<main class="content">@Body</main><footer>Conciliador Contable · ARCA Cliente · Agrupador de Conceptos</footer></div></div>
@* Fecha: 24/10/2026 - TAREA: 00125 - Linea: 4 - Enlace relativo al <base href> para que la app funcione bajo una subruta (PathBase) detrás del Concentrador. *@
<div id="blazor-error-ui" role="alert">Se interrumpió la sesión. <a href="account/login">Volver a ingresar</a></div>
@code {
    List<Acceso> lateral=new();
    string nombre="";
    bool viaAppHub;
    string? seccion;
    protected override async Task OnInitializedAsync()
    {
        var usuario=(await Authentication.GetAuthenticationStateAsync()).User;
        lateral=MenuPrincipal.Lateral(usuario,Mode.Demo).ToList();
        nombre=usuario.FindFirst("display_name")?.Value??usuario.Identity?.Name??"";
        viaAppHub=usuario.HasClaim("via","apphub");
    }
    protected override void OnParametersSet()
    {
        var ruta="/"+Navigation.ToBaseRelativePath(Navigation.Uri).Split('?','#')[0].TrimEnd('/');
        var acceso=MenuPrincipal.Accesos.FirstOrDefault(a=>a.Ruta==ruta);
        seccion=acceso==null?null:(acceso.Modulo==MenuPrincipal.ModArca?"ARCA":"Agrupador")+" / "+acceso.Titulo;
    }
}
