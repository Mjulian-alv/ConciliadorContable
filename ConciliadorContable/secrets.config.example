<?xml version="1.0" encoding="utf-8" ?>
<!-- Plantilla. Copiar a secrets.config (que git ignora) y poner la password real.
     Las claves definidas acá pisan a las de App.config.
     Si secrets.config no existe, la app arranca con el valor de App.config
     (Password=DEFINIR) y fallará al conectar: eso es intencional. -->
<appSettings>
  <add key="ConciliadorSqlConnectionString"
       value="Server=192.168.7.51;Database=alvesu;User Id=conciliador;Password=PONER_PASSWORD_ACA;TrustServerCertificate=True;" />
</appSettings>
